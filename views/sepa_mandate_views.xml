<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEPA Mandate Form View -->
    <record id="view_sepa_mandate_form" model="ir.ui.view">
        <field name="name">sepa.mandate.form</field>
        <field name="model">sepa.mandate</field>
        <field name="arch" type="xml">
            <form string="Mandato SEPA">
                <header>
                    <button name="action_activate" string="Activar"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Cerrar"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_revoke" string="Revocar"
                            type="object" class="btn-danger"
                            invisible="state not in ('draft', 'active')"/>
                    <button name="action_reset_to_draft" string="Volver a Borrador"
                            type="object"
                            invisible="state not in ('closed', 'revoked')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos del Mandato">
                            <field name="unique_mandate_reference"/>
                            <field name="scheme"/>
                            <field name="sequence_type"/>
                            <field name="signature_date"/>
                            <field name="creditor_identifier"/>
                        </group>
                        <group string="Datos del Deudor">
                            <field name="partner_id"/>
                            <field name="partner_bank_id"/>
                            <field name="iban"/>
                            <field name="bic"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEPA Mandate List View -->
    <record id="view_sepa_mandate_list" model="ir.ui.view">
        <field name="name">sepa.mandate.list</field>
        <field name="model">sepa.mandate</field>
        <field name="arch" type="xml">
            <tree string="Mandatos SEPA" decoration-success="state == 'active'"
                  decoration-muted="state in ('closed', 'revoked')">
                <field name="unique_mandate_reference"/>
                <field name="partner_id"/>
                <field name="iban"/>
                <field name="scheme"/>
                <field name="sequence_type"/>
                <field name="signature_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- SEPA Mandate Search View -->
    <record id="view_sepa_mandate_search" model="ir.ui.view">
        <field name="name">sepa.mandate.search</field>
        <field name="model">sepa.mandate</field>
        <field name="arch" type="xml">
            <search string="Buscar Mandatos">
                <field name="unique_mandate_reference"/>
                <field name="partner_id"/>
                <field name="iban"/>
                <filter name="active_mandates" string="Activos"
                        domain="[('state', '=', 'active')]"/>
                <filter name="draft_mandates" string="Borradores"
                        domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_sepa_mandate_kanban" model="ir.ui.view">
        <field name="name">sepa.mandate.kanban</field>
        <field name="model">sepa.mandate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="alq_kanban_mand" sample="1">
                <field name="unique_mandate_reference"/>
                <field name="partner_id"/>
                <field name="iban"/>
                <field name="scheme"/>
                <field name="sequence_type"/>
                <field name="signature_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click alq_mand_card alq_mand_#{record.state.raw_value}">
                            <div class="alq_mc_icon">
                                <i class="fa fa-file-text-o"/>
                            </div>
                            <div class="alq_mc_main">
                                <div class="alq_mc_ref"><field name="unique_mandate_reference"/></div>
                                <div class="alq_mc_partner"><field name="partner_id"/></div>
                                <div class="alq_mc_iban"><field name="iban"/></div>
                                <div class="alq_mc_meta">
                                    <span class="alq_mc_scheme">
                                        <field name="scheme"/>
                                    </span>
                                    <span class="alq_mc_seq">
                                        <field name="sequence_type"/>
                                    </span>
                                    <span class="alq_mc_date">
                                        <i class="fa fa-calendar"/> <field name="signature_date"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sepa_mandate" model="ir.actions.act_window">
        <field name="name">Mandatos SEPA</field>
        <field name="res_model">sepa.mandate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_mandates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo mandato SEPA
            </p>
            <p>
                Los mandatos SEPA autorizan el adeudo directo en la cuenta del cliente.
            </p>
        </field>
    </record>

</odoo>
