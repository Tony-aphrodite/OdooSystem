<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_alquiler" model="ir.module.category">
        <field name="name">Alquiler de Equipos</field>
        <field name="sequence">200</field>
    </record>

    <!-- User Group -->
    <record id="group_alquiler_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_alquiler"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_alquiler_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_alquiler"/>
        <field name="implied_ids" eval="[(4, ref('group_alquiler_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
