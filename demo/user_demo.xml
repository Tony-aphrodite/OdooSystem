<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Demo Rental Manager -->
    <record id="user_demo_manager" model="res.users">
        <field name="name">Laura Gómez</field>
        <field name="login">gestor</field>
        <field name="email">gestor@example.com</field>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('account.group_account_manager')),
            (4, ref('alquiler_equipos.group_alquiler_manager')),
        ]"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="tz">Europe/Madrid</field>
    </record>

    <!-- Demo Field Technician -->
    <record id="user_demo_technician" model="res.users">
        <field name="name">Javier Ruiz</field>
        <field name="login">tecnico</field>
        <field name="email">tecnico@example.com</field>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('alquiler_equipos.group_alquiler_user')),
        ]"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="tz">Europe/Madrid</field>
    </record>

</odoo>
