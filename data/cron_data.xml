<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron: Generate Recurring Invoices -->
    <record id="cron_generate_recurring_invoices" model="ir.cron">
        <field name="name">Alquiler: Generar Facturas Recurrentes</field>
        <field name="model_id" ref="model_recurring_invoice"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_recurring_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>

</odoo>
